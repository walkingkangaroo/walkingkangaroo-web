# Facts the scripts read. One KEY=value per line, no spaces around the equals sign.
# Shown to /do, /shape and /retro, and read by .claude/scripts/cleanup-merged-branches.sh.

# The branch pull requests merge into: main or master.
DEFAULT_BRANCH=main

# checkout: one working copy, /do switches branches in it.
# worktree: the main checkout is shared with other live sessions, so /do works in a git worktree
#           and never switches branches in the main checkout.
WORKING_COPY=checkout

# The project's folder in Grant's tracker vault, exactly as named there.
TRACKER_PROJECT=Website

# Where .claude/scripts/tracker.sh clones the tracker from when this machine has no copy.
TRACKER_REMOTE=https://github.com/walkingkangaroo/tracker.git
