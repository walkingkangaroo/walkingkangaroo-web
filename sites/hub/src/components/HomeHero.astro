---
import { Image } from 'astro:assets';
import StageMeter from './StageMeter.astro';
import type { Project } from '../lib/content';
import { newsletterLive } from '../lib/newsletter';

interface Props {
  /** The featured project. */
  project: Project;
}

const { project } = Astro.props;
const { name, oneLiner, stage, platforms, cover, heroBackdrop, wide, phone, lockup, eyebrow, headline, summary, link } = project.data;

// The pane's backdrop is the project's own hero version of its cover (the swoops without the mark),
// else its cover. `cover` itself is unchanged everywhere else (0038).
const backdrop = heroBackdrop ?? cover;
// With both a wide screen and a phone, they stand together. With only one, it stands alone.
const duo = Boolean(wide && phone);
// The phone's rendered width: 16.1% of the pane's width as one of a pair (its screenshot, inside the
// bezel), or 0024's single phone.
const phoneSizes = duo
  ? '(min-width: 1280px) 108px, (min-width: 1024px) calc((100vw - 128px) * 7 / 12 * 0.161), calc((100vw - 2 * clamp(16px, 4vw, 40px)) * 0.161)'
  : '(min-width: 1024px) 165px, 33vw';

// Everything below reads from the project's content file (0024). A featured project without the
// hero fields gets the older hero's text: its name set in Outfit, its one-liner, "In development".
const eyebrowText = eyebrow ?? (platforms.length ? `In development · ${platforms.join(' / ')}` : 'In development');
// With no link, the first button is "Follow development", which goes to the newsletter band. While the
// newsletter is hidden (0034) there is no first button, and the hero shows only the second one.
const primary = link ?? (newsletterLive ? { label: 'Follow development', href: '/#news' } : undefined);
// The second button jumps to the "How a visit goes" section just below the hero (0025).
const secondary = { label: 'See how it works', href: '#how' };
---

<section id="top" class="container hero-section">
  <div class="hero">
    <div class:list={['pane', { 'pane--duo': duo }]}>
      {
        backdrop && (
          <Image
            class="pane__cover"
            src={backdrop}
            alt=""
            widths={[480, 800, 1200, 1800]}
            sizes="(min-width: 1280px) 672px, (min-width: 1024px) calc((100vw - 128px) * 7 / 12), calc(100vw - 2 * clamp(16px, 4vw, 40px))"
            loading="eager"
            fetchpriority="high"
          />
        )
      }
      {
        wide && (
          <div class="pane__wide">
            <Image
              class="pane__wide-shot"
              src={wide}
              alt=""
              widths={[480, 760, 1020, 1520]}
              sizes="(min-width: 1280px) 508px, (min-width: 1024px) calc((100vw - 128px) * 7 / 12 * 0.756), calc((100vw - 2 * clamp(16px, 4vw, 40px)) * 0.756)"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )
      }
      {
        phone && (
          <div class="pane__phone">
            <Image
              class="pane__shot"
              src={phone}
              alt=""
              widths={[160, 240, 320, 480, 640]}
              sizes={phoneSizes}
              loading="eager"
            />
          </div>
        )
      }
      <div class="pane__fog" aria-hidden="true"></div>
      <div class="pane__blade" aria-hidden="true"></div>
    </div>

    <div class="hero__text">
      <span class="eyebrow">{eyebrowText}</span>
      {
        lockup ? (
          <h1 class="lockup">
            <img src={lockup.src} width={lockup.width} height={lockup.height} alt={name} />
          </h1>
        ) : (
          <h1 class="name">{name}</h1>
        )
      }
      {headline && <p class="headline">{headline}</p>}
      {summary ? <p class="summary">{summary}</p> : <p class="one-liner">{oneLiner}</p>}
      <StageMeter stage={stage} size="md" label="long" detail={platforms.length ? platforms.join(', ') : undefined} />
      <div class="actions">
        {primary && <a class="btn btn--solid" href={primary.href}>{primary.label}</a>}
        <a class="btn btn--outline" href={secondary.href}>{secondary.label}</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* How far the squeegee has travelled, as a share of the sweep's circle (see .pane__fog). It is
     registered so it can be animated. Its initial value is the end of the sweep, so wherever the
     animation doesn't run, the glass is clean. */
  @property --p {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 101%;
  }

  .hero-section {
    padding-top: 16px;
  }

  /* Phones and tablets: the pane first, then the text, both the full width of the page. */
  .hero {
    display: grid;
    gap: 28px;
  }

  /* The pane: the project's hero backdrop (its cover, or a version of it without the mark), the wide
     screen and the phone, then the fog and the blade over all of it. 5:4 here and 16:10 from
     1024 px. */
  .pane {
    --sweep-delay: 400ms;
    --sweep-duration: 1000ms;
    --sweep-ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    width: 100%;
    aspect-ratio: 5 / 4;
    border-radius: 24px;
    background: var(--site-media);
    animation: sweep var(--sweep-duration) var(--sweep-ease) var(--sweep-delay) both;
  }

  .pane__cover {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The wide screen and the phone: real screenshots in plain Ink CSS frames, standing on the
     backdrop and under the fog, so the sweep clears them with the rest of the scene. Every size is
     a share of the pane, and the bezels are shares of the pane's width, so it all scales with it.
     W is the pane's width and H its height (5:4 under 1024 px, so H = 0.8 W; 16:10 from there, so
     H = 0.625 W).

     Both devices, as a pair (.pane--duo):
       Wide screen: 78% of W wide, 4% from the left, bezel 1.2% of W. Its screenshot is 16:10, so the
         frame is 0.497 W tall. Top at 10% of H at 5:4 (0.08 W) and 5% of H at 16:10 (0.031 W), so
         it ends at 72% of H at 5:4 and 84% of H at 16:10, and its right edge is at 82% of W.
       Phone: 9% from the right and 5% from the bottom, bezel 1.6% of W. Its height is 47.5% of H at
         5:4 and 60.8% of H at 16:10. Both are 0.38 W, so its frame is 19.3% of W wide.
     So the phone is the same size against the pane's width at both ratios, and 76% of the wide
     screen's height at both. Its left edge is at 71.7% of W, so it covers the wide screen's right
     10.3% of W, from 0.38 W down at 5:4 and 0.214 W down at 16:10: the Sun column, below its
     header, and the empty space below the week's cards. Sat is fully visible. The Thu column and
     its Shops run block, at 53 to 64% across the screenshot, are not covered. Both stay inside
     the pane with a margin of 4% of W or more at 5:4 and 3% of W or more at 16:10 (the wide
     screen's top and the phone's bottom are 5% of H, 0.031 W).

     One device alone: the wide screen is centred, and the phone stands centred a little left of
     the middle at 88% of H, as 0024 had it. */
  .pane__wide {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    box-sizing: border-box;
    width: 78%;
    padding: 1.2%;
    border-radius: 2.6% / 4%;
    background: var(--wk-ink);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--site-text-quiet) 70%, transparent),
      0 14px 32px color-mix(in srgb, var(--wk-ink) 35%, transparent);
  }

  .pane__wide-shot {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.1% / 1.7%;
  }

  .pane__phone {
    position: absolute;
    top: 6%;
    left: 40%;
    transform: translateX(-50%);
    box-sizing: border-box;
    height: 88%;
    padding: 1.6%;
    border-radius: 17% / 8%;
    background: var(--wk-ink);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--site-text-quiet) 70%, transparent),
      0 14px 32px color-mix(in srgb, var(--wk-ink) 35%, transparent);
  }

  .pane--duo .pane__wide {
    top: 10%;
    left: 4%;
    transform: none;
  }

  .pane--duo .pane__phone {
    top: auto;
    right: 9%;
    bottom: 5%;
    left: auto;
    transform: none;
    height: 47.5%;
  }

  .pane__shot {
    display: block;
    width: auto;
    height: 100%;
    border-radius: 15% / 7%;
  }

  .pane__fog,
  .pane__blade {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* The fog and the blade are only drawn where masks work, so the fog can never be left covering
     the pane and the blade never sweeps across glass that was never fogged. */
  .pane__fog,
  .pane__blade {
    display: none;
  }

  /* The fog: --site-media at 70%, with a Paper haze from the 0010 tints over it. The mask's clear
     area is a circle centred up and left of the pane, so its edge is an arc from the top right to
     the bottom left, the curve of PanePilot's Curved Sweep mark. Everything inside the circle is
     clean. At --p 101% the circle passes the pane's farthest corner. The mask only reads alpha, so
     its opaque stop uses Ink. `var(--p, 101%)` keeps the glass clean where --p isn't registered. */
  @supports (mask-image: none) or (-webkit-mask-image: none) {
    .pane__fog {
      display: block;
      background:
        radial-gradient(ellipse 38% 30% at 28% 38%, color-mix(in srgb, var(--site-progress) 55%, transparent), transparent 70%),
        radial-gradient(ellipse 30% 26% at 76% 72%, color-mix(in srgb, var(--site-progress) 42%, transparent), transparent 70%),
        radial-gradient(ellipse 22% 18% at 60% 20%, color-mix(in srgb, var(--site-rule) 35%, transparent), transparent 70%),
        repeating-linear-gradient(118deg, color-mix(in srgb, var(--site-progress) 14%, transparent) 0 2px, transparent 2px 11px),
        color-mix(in srgb, var(--site-media) 70%, transparent);
      backdrop-filter: blur(7px) saturate(0.5);
      -webkit-mask-image: radial-gradient(circle farthest-corner at -30% -55%, transparent var(--p, 101%), var(--wk-ink) calc(var(--p, 101%) + 4px));
      mask-image: radial-gradient(circle farthest-corner at -30% -55%, transparent var(--p, 101%), var(--wk-ink) calc(var(--p, 101%) + 4px));
    }

    .pane__blade {
      display: block;
    }
  }

  /* The blade and its wet edge, on the same circle: a thin Ink line where the blade is, with a
     Paper sheen trailing it on the clean side. It is hidden at rest and only shows while the sweep
     runs, fading as it finishes. */
  .pane__blade {
    opacity: 0;
    background: radial-gradient(
      circle farthest-corner at -30% -55%,
      transparent calc(var(--p, 101%) - 16px),
      color-mix(in srgb, var(--wk-paper) 35%, transparent) calc(var(--p, 101%) - 7px),
      color-mix(in srgb, var(--wk-paper) 90%, transparent) calc(var(--p, 101%) - 2px),
      color-mix(in srgb, var(--wk-ink) 60%, transparent) calc(var(--p, 101%) - 1px),
      color-mix(in srgb, var(--wk-ink) 60%, transparent) calc(var(--p, 101%) + 3px),
      transparent calc(var(--p, 101%) + 4px)
    );
    animation: wet var(--sweep-duration) var(--sweep-ease) var(--sweep-delay) both;
  }

  @keyframes sweep {
    from {
      --p: 22%;
    }
    to {
      --p: 101%;
    }
  }

  @keyframes wet {
    from {
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  /* Reduced motion: no sweep and no fog. The pane is clean from the first frame. */
  @media (prefers-reduced-motion: reduce) {
    .pane,
    .pane__blade {
      animation: none;
    }

    .pane__fog,
    .pane__blade {
      display: none;
    }
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    min-width: 0;
  }

  .eyebrow {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--wk-rust);
  }

  /* The lockup is the heading, never the name set in Outfit (PanePilot's brand rules). It keeps
     clear space of a quarter of its mark's tile on every side, and the tile is as wide as the
     lockup is tall: 11 px at 44 px, 13 px at 52 px. The text column's 18 px gap gives that above
     and below; the page margin and the empty rest of the column give it at the sides. */
  .lockup {
    --lockup-h: 44px;
    margin: 0;
    line-height: 0;
  }

  .lockup img {
    display: block;
    height: var(--lockup-h);
    width: auto;
  }

  /* The older hero's heading, for a featured project without a lockup. */
  .name {
    margin: 0;
    font-size: clamp(44px, 6vw, 80px);
    line-height: 1;
    overflow-wrap: anywhere;
  }

  /* Tracking of -2.5% once the name is 48 px or more (6vw reaches 48 px at 800 px wide). */
  @media (min-width: 800px) {
    .name {
      letter-spacing: -0.025em;
    }
  }

  .headline {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(30px, 3vw, 42px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .summary {
    margin: 0;
    max-width: 36ch;
    font-size: 18px;
    color: var(--site-text-quiet);
  }

  .one-liner {
    margin: 0;
    font-size: 20px;
    color: var(--site-text-quiet);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    padding-top: 6px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 24px;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
  }

  /* Paper on Rust, 5.7:1. */
  .btn--solid {
    background: var(--wk-rust);
    color: var(--wk-paper);
  }

  .btn--solid:hover {
    background: var(--wk-ink);
    color: var(--wk-paper);
  }

  .btn--outline {
    border: 2px solid var(--wk-ink);
    color: var(--wk-ink);
  }

  .btn--outline:hover {
    background: var(--wk-ink);
    color: var(--wk-paper);
  }

  /* Phones: the buttons span the full width. */
  @media (max-width: 719px) {
    .actions,
    .btn {
      width: 100%;
    }
  }

  /* Desktop: the text on the left and the pane on the right, side by side and vertically centred,
     with no overlap and no box behind the text. At 1440 px wide (a 1200 px content box) the text
     column is 480 px and the pane 672 x 420 px; at 1024 px the text is about 373 px and the pane
     about 523 x 327 px. */
  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 48px;
      align-items: center;
    }

    .pane {
      grid-column: 2;
      grid-row: 1;
      aspect-ratio: 16 / 10;
    }

    /* The pane is shorter against its width, so the pair's vertical shares change (see the
       comment on .pane__wide). */
    .pane--duo .pane__wide {
      top: 5%;
    }

    .pane--duo .pane__phone {
      height: 60.8%;
    }

    .hero__text {
      grid-column: 1;
      grid-row: 1;
    }

    /* 40 px at 1024 px wide, 52 px from about 1444 px. */
    .lockup {
      --lockup-h: clamp(40px, 3.6vw, 52px);
    }

    .name {
      font-size: 48px;
    }
  }
</style>
