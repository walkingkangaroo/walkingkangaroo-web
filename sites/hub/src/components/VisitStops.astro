---
// "How a visit goes": four stops in order on a --site-panel band (0025). The copy is a draft for
// Grant to rewrite (0014). Every line is checked against PanePilot's docs; the vocabulary is
// visit, pane, run and invoice (0025).
//
// A stop's pictures are the featured project's `screenshots` entries whose `stop` is its number,
// listed in its content file with their alt text and crop. A stop with no entry shows no picture.
import { Image } from 'astro:assets';
import { getFeaturedProject } from '../lib/content';

const featured = await getFeaturedProject();
const screenshots = featured.data.screenshots ?? [];
// The empty spacer that keeps a row lined up is only needed when some stop has a picture.
const anyShots = screenshots.some((shot) => shot.stop);

const stops = [
  {
    title: 'Quote per pane',
    text: 'Build it from your price book, with your own surcharges like Ladder or Roof. An accepted quote sets the price for the visits that follow.',
  },
  {
    title: 'The visits come round',
    text: 'Set each schedule once: fortnightly, every 4 weeks, monthly. A street of shops can share one run.',
  },
  {
    title: 'Do the visit from your phone',
    text: 'The visit card has the address, the access notes, the checklist and your start and finish times.',
  },
  {
    title: 'Invoice it, pay the crew',
    text: "Send the invoice by email or SMS, record the transfer or the cash, then approve each worker's time.",
  },
];
---

<section id="how" class="run" aria-labelledby="how-heading">
  <div class="container">
    <div class="run__head">
      <h2 id="how-heading">How a visit goes</h2>
      <p>Four stops, from the first quote to the money landing.</p>
    </div>
    <ol class="stops" role="list">
      {
        stops.map((stop, i) => {
          const shots = screenshots.filter((shot) => shot.stop === i + 1);
          return (
          <li class="stop">
            {shots.length > 0 ? (
              <div class="stop__shot" style={`grid-template-rows: ${shots.map((shot) => `minmax(0, ${shot.weight ?? 1}fr)`).join(' ')}`}>
                {shots.map((shot) => (
                  <Image
                    class="stop__img"
                    src={shot.src}
                    alt={shot.alt}
                    style={shot.position ? `object-position: ${shot.position}` : undefined}
                    widths={[360, 560, 780]}
                    sizes="(min-width: 1280px) 280px, (min-width: 900px) 25vw, min(420px, calc(100vw - 32px))"
                    loading="lazy"
                  />
                ))}
              </div>
            ) : anyShots ? (
              /* KAN-913: stop 2 has no picture yet. Its weeks calendar is added as one more `screenshots`
                 entry with `stop: 2` in panepilot.md. Until then this is plain empty space, so the
                 numbers and headings of the four stops still line up in a row. No box, no placeholder. */
              <div class="stop__shot stop__shot--none" aria-hidden="true" />
            ) : null}
            <span class="stop__num" aria-hidden="true">{i + 1}</span>
            <h3>{stop.title}</h3>
            <p>{stop.text}</p>
          </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  /* The hero has no bottom padding of its own, so the band keeps its distance from the buttons. */
  .run {
    margin-top: clamp(40px, 6vw, 64px);
    padding-block: clamp(56px, 8vw, 88px);
    background: var(--site-panel);
  }

  .run__head {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 40rem;
    margin-bottom: 36px;
  }

  .run__head h2 {
    margin: 0;
    font-size: clamp(28px, 5vw, 36px);
  }

  .run__head p {
    margin: 0;
    color: var(--site-text-quiet);
  }

  /* Stacked on phones and tablets, four equal columns from 900 px. There are no footprints
     between or beside the stops. */
  .stops {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stop {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  /* One frame shape for every stop, so the row lines up: 780 x 935 source pixels, the width of a
     screenshot and the height that shows "Finished 8:41 am" down to the ticked checklist. A stop with
     two pictures splits it by their `weight`, with a 4 px gap between. Each picture is cropped by
     its own `object-position`. On phones and tablets the frame stops growing at 420 px wide. */
  .stop__shot {
    display: grid;
    gap: 4px;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 780 / 935;
    min-height: 0;
    overflow: hidden;
  }

  .stop__img {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    min-height: 0;
    border: 1px solid var(--site-rule);
    border-radius: 14px;
    object-fit: cover;
  }

  /* A stop without a picture keeps the space only where the stops sit in a row. */
  .stop__shot--none {
    display: none;
  }

  /* Paper on Ink, 14.1:1. */
  .stop__num {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--wk-ink);
    color: var(--wk-paper);
    font-size: 16px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .stop h3 {
    margin: 0;
  }

  /* Quiet on Panel, 8.9:1. */
  .stop p {
    margin: 0;
    font-size: 16px;
    color: var(--site-text-quiet);
  }

  @media (min-width: 900px) {
    .stops {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      align-items: start;
      gap: 0 28px;
    }

    .stop__shot--none {
      display: block;
    }
  }
</style>
