---
// "How a visit goes": four stops in order on a --site-panel band (0025). The copy is a draft for
// Grant to rewrite (0014). Every line is checked against PanePilot's docs; the vocabulary is
// visit, pane, run and invoice (0025).
//
// A stop's pictures are the featured project's `screenshots` entries whose `stop` is its number,
// listed in its content file with their alt text. Each is shown whole, at its own aspect ratio.
// A stop with no entry shows no picture.
import { Image } from 'astro:assets';
import { getFeaturedProject } from '../lib/content';

const featured = await getFeaturedProject();
const screenshots = featured.data.screenshots ?? [];
// A picture is one column of four. The content is 1200 px wide at most (1280 px less 40 px padding
// each side, from 1000 px; 4vw each side below that) and there are three 28 px gaps. Under 900 px
// it is no wider than 320 px.
const sizes =
  '(min-width: 1280px) 280px, (min-width: 1000px) calc((100vw - 164px) / 4), (min-width: 900px) calc((92vw - 84px) / 4), min(320px, calc(100vw - 32px))';

const stops = [
  {
    title: 'Quote per pane',
    text: 'Build it from your price book, with your own surcharges like Ladder or Roof. An accepted quote sets the price for the visits that follow.',
  },
  {
    title: 'The visits come round',
    text: 'Set each schedule once: fortnightly, every 4 weeks, monthly. A street of shops can share one run.',
  },
  {
    title: 'Do the visit from your phone',
    text: 'The visit card has the address, the access notes, the checklist and your start and finish times.',
  },
  {
    title: 'Invoice it, pay the crew',
    text: "Send the invoice by email or SMS, record the transfer or the cash, then approve each worker's time.",
  },
];
---

<section id="how" class="run" aria-labelledby="how-heading">
  <div class="container">
    <div class="run__head">
      <h2 id="how-heading">How a visit goes</h2>
      <p>Four stops, from the first quote to the money landing.</p>
    </div>
    <ol class="stops" role="list">
      {
        stops.map((stop, i) => {
          const shots = screenshots.filter((shot) => shot.stop === i + 1);
          return (
          <li class="stop">
            <span class="stop__num" aria-hidden="true">{i + 1}</span>
            <h3>{stop.title}</h3>
            <p>{stop.text}</p>
            {shots.length > 0 ? (
              <div class="stop__shots">
                {shots.map((shot) => (
                  <Image
                    class="stop__img"
                    src={shot.src}
                    alt={shot.alt}
                    widths={[360, 560, 780]}
                    sizes={sizes}
                    loading="lazy"
                  />
                ))}
              </div>
            ) : null}
          </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  /* The hero has no bottom padding of its own, so the band keeps its distance from the buttons. */
  .run {
    margin-top: clamp(40px, 6vw, 64px);
    padding-block: clamp(56px, 8vw, 88px);
    background: var(--site-panel);
  }

  .run__head {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 40rem;
    margin-bottom: 36px;
  }

  .run__head h2 {
    margin: 0;
    font-size: clamp(28px, 5vw, 36px);
  }

  .run__head p {
    margin: 0;
    color: var(--site-text-quiet);
  }

  /* Stacked on phones and tablets, four equal columns from 900 px. There are no footprints
     between or beside the stops. */
  .stops {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Number, heading, text, then the picture. The gaps are margins, not grid gaps, so they hold in
     both layouts. */
  .stop {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .stop h3 {
    margin: 12px 0 0;
  }

  /* Quiet on Panel, 8.9:1. */
  .stop p {
    margin: 12px 0 0;
    font-size: 16px;
    color: var(--site-text-quiet);
  }

  /* Each picture is shown whole at its own aspect ratio. Under 900 px it is no wider than 320 px,
     so the tallest (the quote) is about one and a half screens tall at most. A stop with two
     pictures stacks them with a 12 px gap. */
  .stop__shots {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 320px;
    margin-top: 20px;
  }

  .stop__img {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: auto;
    border: 1px solid var(--site-rule);
    border-radius: 14px;
  }

  /* Paper on Ink, 14.1:1. */
  .stop__num {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--wk-ink);
    color: var(--wk-paper);
    font-size: 16px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* From 900 px the four stops are one grid and each stop is a subgrid of its four rows: number,
     heading, text, picture. The rows are shared, so the numbers, headings and pictures' tops line
     up even when one stop's text wraps to more lines than another's. The pictures' bottoms are
     left uneven. A stop with no picture leaves its last row empty. Without subgrid support
     `align-content: start` makes each stop a plain top-aligned stack. */
  @media (min-width: 900px) {
    .stops {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-rows: repeat(4, auto);
      gap: 0 28px;
    }

    .stop {
      display: grid;
      grid-row: span 4;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: subgrid;
      align-content: start;
    }

    .stop__shots {
      align-self: start;
    }
  }
</style>
