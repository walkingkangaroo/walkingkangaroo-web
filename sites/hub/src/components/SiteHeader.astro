---
import logo from '../assets/brand/walking-kangaroo-logo-horizontal-primary.svg';
---

<!-- The header is the logo alone, linking home, with no navigation links (0047). -->
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/" aria-label="Walking Kangaroo home">
      <img src={logo.src} width="191" height="28" alt="" />
    </a>
  </div>
</header>

<style>
  .site-header__inner {
    display: flex;
    align-items: center;
    padding-block: 24px;
  }

  .site-header__logo {
    display: inline-flex;
  }

  .site-header__logo img {
    display: block;
    height: 28px;
    width: auto;
  }
</style>
