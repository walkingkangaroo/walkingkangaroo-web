---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeWall from '../components/HomeWall.astro';
import HomeHero from '../components/HomeHero.astro';
import NewsletterBand from '../components/NewsletterBand.astro';
import { newsletterLive } from '../lib/newsletter';
import { getFeaturedProject } from '../lib/content';

// The home page is the Rust wall in the header's place, PanePilot's pane hung across its edge, then
// the newsletter band once Kit is connected, and nothing else (0049).
const featured = await getFeaturedProject();
---

<BaseLayout title="Walking Kangaroo" description="Grant's games and apps, and how far along each one is." siteHeader={false}>
  <div class="home">
    <HomeWall />
    <HomeHero project={featured} />
  </div>

  {newsletterLive && <NewsletterBand />}
</BaseLayout>

<style>
  /* The overlap: how far the pane hangs up across the wall's lower edge. The wall's bottom padding,
     the hero's negative top margin and the label's offset all use it. .home is a size container
     around the wall and the hero, so `cqi` in all three is this block's width and the lengths are
     always the same. Not 100vw, which includes a classic scrollbar; and not percentages, which
     resolve against the label's 380 px grid column on the label.

     W is the pane's width; --hang-gutter is .container's padding, in vw like it.
       Under 1024 px: W = min(column, 720 px), at 5:4, with 36% of its height on the wall.
       From 1024 px: W = column - 56 px - the 380 px label, at 16:10, with 24% of its height on the wall.
     The switch is @media (min-width: 1024px), the same condition as the hero's two columns and the
     pane's 16:10. */
  .home {
    container-type: inline-size;
    --hang-gutter: clamp(16px, 4vw, 40px);
    --hang-label-w: 380px;
    --hang-gap: 56px;
    --overlap: calc(min(100cqi - 2 * var(--hang-gutter), 720px) * 0.8 * 0.36);
  }

  @media (min-width: 1024px) {
    .home {
      --overlap: calc((min(100cqi, 1280px) - 2 * var(--hang-gutter) - var(--hang-gap) - var(--hang-label-w)) * 0.625 * 0.24);
    }
  }
</style>
