---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import PostCard from '../components/PostCard.astro';
import NewsletterBand from '../components/NewsletterBand.astro';
import { newsletterLive } from '../lib/newsletter';
import { getFeaturedProject, getPublishedPosts } from '../lib/content';

// The home page is the hero, then the devlog and the newsletter band once each exists (0046).
const featured = await getFeaturedProject();
// The Devlog section is left out entirely until there is a published post.
const latestPosts = (await getPublishedPosts()).slice(0, 3);
---

<BaseLayout title="Walking Kangaroo" description="Grant's games and apps, and how far along each one is.">
  <HomeHero project={featured} />

  {
    latestPosts.length > 0 && (
      <section id="devlog" class="container section">
        <div class="section__head section__head--ruled">
          <h2>Devlog</h2>
          <a class="all-posts" href="/devlog/">
            All posts →
          </a>
        </div>
        <div class="posts">
          {latestPosts.map((post) => <PostCard post={post} />)}
        </div>
      </section>
    )
  }

  {newsletterLive && <NewsletterBand />}
</BaseLayout>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: clamp(40px, 6vw, 64px);
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  .section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .section__head--ruled {
    padding-top: 20px;
    border-top: 2px solid var(--wk-ink);
  }

  h2 {
    margin: 0;
    font-size: clamp(28px, 5vw, 36px);
  }

  .all-posts {
    font-weight: 600;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 32px;
  }
</style>
