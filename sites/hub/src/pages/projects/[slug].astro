---
import { render } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaPanel from '../../components/MediaPanel.astro';
import ProjectStagePanel from '../../components/ProjectStagePanel.astro';
import ProjectDevlog from '../../components/ProjectDevlog.astro';
import WorkingOn from '../../components/WorkingOn.astro';
import { getProjects, getPublishedPosts, type Project } from '../../lib/content';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { name, oneLiner, stage, platforms, target, cover, clip, workingOn, lockup, link, screenshots } = project.data;

// Newest first, so the first post is the latest update. In dev this includes drafts.
const posts = await getPublishedPosts(project);
const lastUpdate = posts[0]?.data.date;

// The Markdown body is optional: render it only when the file has one.
const hasBody = Boolean(project.body?.trim());
const { Content } = await render(project);

// The share image is the cover at 1200 px wide; BaseLayout makes the path absolute and falls back to the default.
const shareImage = cover ? (await getImage({ src: cover, width: 1200, format: 'jpg' })).src : undefined;

const hasSidebar = Boolean(workingOn?.length);
const hasLower = posts.length > 0 || hasSidebar;
---

<BaseLayout title={name} description={oneLiner} image={shareImage}>
  <div class="container page">
    <div class="top">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/#games">In the works</a>{' '}
        <span class="here"><span aria-hidden="true">/ </span>{name}</span>
      </nav>

      <div class="intro">
        <div class="intro__text">
          {
            lockup ? (
              <h1 class="lockup">
                <img src={lockup.src} width={lockup.width} height={lockup.height} alt={name} />
              </h1>
            ) : (
              <h1>{name}</h1>
            )
          }
          <p class="one-liner">{oneLiner}</p>
        </div>
        {
          link ? (
            <div class="actions actions--pair">
              <a class="btn btn--solid" href={link.href}>{link.label}</a>
              <a class="btn btn--outline" href="/#news">Follow this project</a>
            </div>
          ) : (
            <div class="actions">
              <a class="follow" href="/#news">Follow this project</a>
            </div>
          )
        }
      </div>

      {
        hasBody && (
          <div class="prose">
            <Content />
          </div>
        )
      }

      <ProjectStagePanel stage={stage} target={target} platforms={platforms} lastUpdate={lastUpdate} />
    </div>

    {/* The cover is the poster for a clip; with neither, this is the plain tint panel. */}
    <MediaPanel
      image={cover}
      clip={clip}
      poster={cover}
      controls
      label={`${name} clip`}
      aspect="16 / 7"
      alt=""
      radius="20px"
      sizes="(min-width: 1280px) 1200px, 100vw"
    />

    {/* The project's real screenshots, in the order of its content file. Only projects that list some. */}
    {
      screenshots?.length ? (
        <section class="shots" aria-label={`${name} screenshots`}>
          <ul class="shots__grid" role="list">
            {screenshots.map((shot) => (
              <li>
                <Image
                  class="shots__img"
                  src={shot.src}
                  alt={shot.alt}
                  widths={[360, 560, 780]}
                  sizes="(min-width: 1280px) 285px, (min-width: 640px) 50vw, calc(100vw - 32px)"
                  loading="lazy"
                />
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

    {
      hasLower && (
        <div class:list={['lower', { 'lower--solo': posts.length === 0 }]}>
          {
            posts.length > 0 && (
              <div class="main">
                <ProjectDevlog posts={posts} />
              </div>
            )
          }
          {
            hasSidebar && (
              <aside class="aside">
                <WorkingOn items={workingOn} />
              </aside>
            )
          }
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 6vw, 64px);
    padding-top: 16px;
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  .top {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .breadcrumb {
    font-size: 15px;
  }

  .here {
    color: var(--site-text-quiet);
  }

  .intro {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 40px;
    align-items: flex-end;
    justify-content: space-between;
  }

  .intro__text {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  h1 {
    margin: 0;
    font-size: clamp(40px, 5vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    overflow-wrap: break-word;
  }

  .one-liner {
    margin: 0;
    max-width: 560px;
    font-size: 20px;
    color: var(--site-text-quiet);
  }

  .follow {
    display: inline-block;
    padding: 14px 22px;
    border-radius: 999px;
    background: var(--wk-ink);
    color: var(--wk-paper);
    font-weight: 600;
    text-decoration: none;
  }

  .follow:hover {
    background: var(--wk-rust);
    color: var(--wk-paper);
  }

  /* A project with a lockup: the lockup is the heading, never the name set in Outfit (PanePilot's
     brand rules). Its clear space is a quarter of its mark's tile on every side, and the tile is as
     wide as the lockup is tall: 11 px at 44 px, 13 px at 52 px. Above, the .top gap is 28 px; below,
     the text column's gap is 14 px; at the left, the page margin is 16 px or more; at the right, the
     empty rest of the column and the 40 px intro gap. Same heights as the home hero. */
  .lockup {
    --lockup-h: 44px;
    margin: 0;
    line-height: 0;
  }

  .lockup img {
    display: block;
    height: var(--lockup-h);
    width: auto;
  }

  @media (min-width: 1024px) {
    .lockup {
      --lockup-h: clamp(40px, 3.6vw, 52px);
    }
  }

  /* A project with a link: the link, then "Follow this project", styled as in the home hero. */
  .actions--pair {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 24px;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
  }

  /* Paper on Rust, 5.7:1. */
  .btn--solid {
    background: var(--wk-rust);
    color: var(--wk-paper);
  }

  .btn--solid:hover {
    background: var(--wk-ink);
    color: var(--wk-paper);
  }

  .btn--outline {
    border: 2px solid var(--wk-ink);
    color: var(--wk-ink);
  }

  .btn--outline:hover {
    background: var(--wk-ink);
    color: var(--wk-paper);
  }

  /* Phones: the buttons span the full width. */
  @media (max-width: 719px) {
    .actions--pair,
    .btn {
      width: 100%;
    }
  }

  /* Screenshots: a simple grid of the whole images, each at its own height, with the stops' 14 px
     radius and 1 px rule border. */
  .shots__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    align-items: start;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shots__img {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: auto;
    border: 1px solid var(--site-rule);
    border-radius: 14px;
  }

  /* The board's flex-wrap layout: the main column wants 560 px, the sidebar 300 px, and the gap is
     64 px, so the sidebar drops below the devlog when the container is narrower than 924 px.
     Without a sidebar the main column grows to the full width. */
  .lower {
    display: flex;
    flex-wrap: wrap;
    gap: 48px 64px;
    align-items: flex-start;
  }

  .main {
    flex: 999 1 560px;
    min-width: 0;
  }

  .aside {
    flex: 1 1 300px;
    min-width: 0;
  }

  /* A sidebar with no devlog beside it keeps its sidebar width, on the left. */
  .lower--solo .aside {
    flex: 0 1 360px;
  }
</style>
