---
// The Quoting demo (KAN-940): copy on the left, the shop drawing and a copy of the app's quote line
// editor beside it. Written in the starting state for visitors without JavaScript: both lines
// already added (6 standard with the ladder, 4 large) with their real totals. quoting.ts takes
// those lines off and starts from nothing quoted, as the plan says.
import ShopDrawing from './ShopDrawing.astro';
import {
  BOOK,
  KINDS,
  LADDER_LABEL,
  START,
  countedSentence,
  eachText,
  lineMoney,
  money,
  type Kind,
} from '../../scripts/quoting';

const PANES: Record<Kind, number> = { standard: 8, large: 4 }; // as drawn in ShopDrawing.astro

const lines = KINDS.map((kind) => {
  const { count, ladder } = START[kind];
  const amount = lineMoney(count, BOOK[kind].eachCents, ladder);
  return {
    kind,
    name: BOOK[kind].name,
    count,
    each: eachText(BOOK[kind].eachCents),
    ladder,
    total: money(amount.total),
    includes: ladder && count > 0 ? `Includes ${LADDER_LABEL} · ${money(amount.surcharge)}.` : '',
  };
});
const total = money(
  KINDS.reduce((sum, kind) => sum + lineMoney(START[kind].count, BOOK[kind].eachCents, START[kind].ladder).total, 0),
);
const counted = countedSentence(
  { standard: START.standard.count, large: START.large.count },
  PANES,
);
---

<div class="quoting">
  <div class="copy">
    <h3>Quote it per pane</h3>
    <p>
      Your price book holds your pane types and rates. Add a line for each, type the count, and tap the
      surcharges you've named yourself, like a ladder for the upstairs windows.
    </p>
  </div>

  <div class="try">
    <div class="stage">
      <strong class="stage-label">Try it: quote this shop</strong>
      <ShopDrawing standard={START.standard.count} large={START.large.count} ladder={START.standard.ladder} />
      <p class="counted" data-counted data-live>{counted}</p>
    </div>

    <section class="card" aria-labelledby="quote-heading">
      <h4 id="quote-heading">What is quoted</h4>

      <ul class="lines" data-lines>
        {
          lines.map((line) => (
            <li class="line" data-kind={line.kind}>
              <p class="desc">
                {line.name}
                <button type="button" class="remove" aria-label={`Remove ${line.name}`}>
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M3 6h18" />
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
                    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                  </svg>
                </button>
              </p>
              <div class="fields">
                <label for={`quote-${line.kind}-count`}>
                  Count
                  <input
                    id={`quote-${line.kind}-count`}
                    class="count"
                    inputmode="numeric"
                    autocomplete="off"
                    value={line.count}
                  />
                </label>
                <label for={`quote-${line.kind}-each`}>
                  Each
                  <input
                    id={`quote-${line.kind}-each`}
                    class="each"
                    inputmode="decimal"
                    autocomplete="off"
                    value={line.each}
                  />
                </label>
              </div>
              <div class="chips" role="group" aria-label={`Surcharges, ${line.name.toLowerCase()}`}>
                <span>Surcharges</span>
                <button type="button" class="chip" aria-pressed={line.ladder ? 'true' : 'false'}>
                  {LADDER_LABEL}
                </button>
              </div>
              <p class="amount">
                <span class="includes">{line.includes}</span>
                <strong class="line-total">{line.total}</strong>
              </p>
            </li>
          ))
        }
      </ul>

      <p class="empty" data-empty hidden>Nothing quoted yet. Add a line from the price book.</p>

      <div class="add-group" role="group" aria-labelledby="add-heading" data-add-group hidden>
        <span id="add-heading">Add from the price book</span>
        {
          KINDS.map((kind) => (
            <button type="button" class="btn add" data-add={kind} hidden>
              + {BOOK[kind].name} · {money(BOOK[kind].eachCents)}
            </button>
          ))
        }
      </div>

      <div class="total" data-live>
        <span>Total</span>
        <strong data-total>{total}</strong>
      </div>

      <p class="fine">
        PanePilot's own quote lines. A new line starts at a count of 1. The shop only shows what's being
        counted. Example prices.
      </p>
    </section>
  </div>
</div>

<style>
  /* Phone and tablet: one column. Copy above the demo; the drawing above the quote card. */
  .quoting {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    padding-top: var(--space-2);
  }

  .try {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }

  .copy h3 {
    margin-bottom: var(--space-2);
  }

  .copy p {
    margin: 0;
    max-width: 40rem;
    color: var(--muted);
  }

  .stage {
    min-width: 0;
    display: grid;
    gap: var(--space-2);
  }

  .stage-label {
    font: 700 1.05rem/1.3 var(--font-display);
  }

  .counted {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  /* 900 px and wider: the drawing and the quote card side by side. */
  @media (min-width: 900px) {
    .try {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: var(--space-5);
    }
  }

  /* 1100 px and wider there is room for the copy on the left as well. */
  @media (min-width: 1100px) {
    .quoting {
      grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
      gap: var(--space-6);
    }
  }

  /* The quote card, in the app's own style. */
  .card {
    min-width: 0;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--white);
    border: 1px solid var(--frame);
    border-radius: 12px;
  }

  .card h4 {
    margin: 0;
    font: 500 1.05rem/1.3 var(--font-text);
  }

  .lines {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .line {
    display: grid;
    gap: 10px;
    padding: var(--space-3);
    border: 1px solid var(--frame);
    border-radius: 8px;
  }

  .desc {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin: 0;
    font-weight: 500;
  }

  .remove {
    display: grid;
    place-items: center;
    min-width: var(--tap);
    min-height: var(--tap);
    margin: calc(-1 * var(--space-2)) calc(-1 * var(--space-2)) calc(-1 * var(--space-2)) 0;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }

  .remove:hover {
    background: var(--glass);
    color: var(--deep-water);
  }

  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .fields label {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-small);
    font-weight: 500;
  }

  .fields input {
    width: 100%;
    min-height: var(--tap);
    padding: 0 10px;
    border: 1px solid var(--frame);
    border-radius: 8px;
    background: var(--white);
    color: var(--deep-water);
    font: 400 1rem var(--font-text);
    font-variant-numeric: tabular-nums;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-small);
    font-weight: 500;
  }

  .chips span {
    width: 100%;
  }

  .chip {
    min-height: 36px;
    padding: 0 var(--space-3);
    border: 1px solid var(--frame);
    border-radius: 999px;
    background: var(--white);
    color: var(--deep-water);
    font: 500 var(--text-small) var(--font-text);
    cursor: pointer;
  }

  .chip[aria-pressed='true'] {
    background: var(--pane-clean);
    border-color: var(--harbour);
    color: var(--harbour-dark);
  }

  .amount {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .includes {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .line-total {
    margin-left: auto;
    font-weight: 500;
  }

  .empty {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .empty[hidden],
  .add-group[hidden],
  .add[hidden] {
    display: none;
  }

  .add-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--frame);
  }

  .add-group span {
    width: 100%;
    font-size: var(--text-small);
    font-weight: 500;
  }

  .add {
    padding: 0 var(--space-3);
    border: 1px solid var(--frame);
    background: var(--white);
    color: var(--harbour-dark);
    font-size: 0.9rem;
  }

  .add:hover {
    background: var(--glass);
  }

  .total {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: var(--space-4);
    font-variant-numeric: tabular-nums;
  }

  .total span {
    font-weight: 500;
  }

  .total strong {
    font: 500 1.35rem/1 var(--font-text);
  }

  .fine {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--muted);
  }
</style>
