---
// The Invoicing demo (KAN-943): copy above or beside a copy of the app's invoice screen. The visitor
// chooses what the customer sees on each line, emails the draft invoice, and records the payment.
// Written in the draft state for visitors without JavaScript: Draft, the job-completed notice, all
// three switches on, and Email invoice. invoicing.ts takes it from there.
//
// Words for Grant to check or rewrite (0014), not the app's:
// - the panel copy (heading and paragraph) below;
// - "Sent invoices keep the details they were sent with.", the line under the switches once sent;
// - "The description and the line's total always show." and "Set once for the business. A customer
//   can have their own.", which come from the plan, not the app.
import { money } from '../../scripts/quoting';
import {
  AMOUNT_TEXT,
  CUSTOMER,
  DETAILS,
  GST_TEXT,
  INVOICE,
  LINES,
  METHODS,
  NOTICE_DRAFT,
  SWITCHES_ALWAYS,
  SWITCHES_HEADING,
  SWITCHES_LOCKED,
  SWITCHES_SCOPE,
  TOTAL_CENTS,
  badgeFor,
  dueDateText,
  issuedText,
  partText,
} from '../../scripts/invoicing';

const start = badgeFor('draft');
---

<div class="invoicing">
  <div class="copy">
    <!-- Draft words for Grant to rewrite. -->
    <h3>Invoice it from the job</h3>
    <p>
      Completing a job raises its draft invoice at the agreed price. Choose what your customer sees on each
      line, email it, and record the bank transfer or cash when it comes in.
    </p>
  </div>

  <div class="screen">
    <div class="main">
      <section class="card invoice" aria-labelledby="inv-heading">
        <div class="head">
          <div>
            <h4 id="inv-heading">Invoice {INVOICE}</h4>
            <p class="fine">{CUSTOMER}</p>
          </div>
          <span class={`badge ${start.kind}`} data-badge>{start.label}</span>
        </div>

        <p class="flash" data-flash>{NOTICE_DRAFT}</p>

        <ul class="lines">
          {
            LINES.map((line) => (
              <li data-line>
                <div class="what">
                  <span class="name">{line.name}</span>
                  <span class="det" data-details>
                    {DETAILS.map((d) => {
                      const text = partText(line, d.key);
                      return text ? (
                        <span class="part" data-part={d.key}>
                          {text}
                        </span>
                      ) : null;
                    })}
                  </span>
                </div>
                <strong>{money(line.totalCents)}</strong>
              </li>
            ))
          }
        </ul>

        <div class="total"><span>Total</span><strong>{money(TOTAL_CENTS)}</strong></div>

        <div class="terms">
          <dl class="dates">
            <dt>Issued</dt>
            <dd data-issued>{issuedText('draft', new Date())}</dd>
            <dt>Due</dt>
            <dd data-due>{dueDateText('draft', new Date())}</dd>
          </dl>
          <p class="fine">{GST_TEXT}</p>
        </div>

        <div class="buttons">
          <button type="button" class="btn btn-primary" data-primary>Email invoice</button>
          <button type="button" class="btn secondary" data-reset hidden>Start again</button>
        </div>

        <form class="pay" data-form hidden>
          <fieldset>
            <legend>How did they pay?</legend>
            <div class="how">
              {
                METHODS.map((m, i) => (
                  <label>
                    <input type="radio" name="method" value={m.value} checked={i === 0} />
                    {m.label}
                  </label>
                ))
              }
            </div>
          </fieldset>
          <label class="amount">
            Amount
            <input type="text" inputmode="decimal" value={AMOUNT_TEXT} readonly />
          </label>
          <div class="buttons">
            <button type="button" class="btn secondary" data-cancel>Cancel</button>
            <button type="submit" class="btn btn-primary">Record payment</button>
          </div>
        </form>
      </section>

      <section class="card payments" aria-labelledby="inv-payments-heading" data-payments hidden>
        <h4 id="inv-payments-heading">Payments</h4>
        <p class="row">
          <span data-payment-row></span>
          <span class="figure">{money(TOTAL_CENTS)}</span>
        </p>
      </section>
    </div>

    <section class="card switches" aria-labelledby="inv-switches-heading">
      <h4 id="inv-switches-heading">{SWITCHES_HEADING}</h4>
      <p class="fine">{SWITCHES_ALWAYS}</p>
      <div role="group" aria-labelledby="inv-switches-heading">
        {
          DETAILS.map((d) => (
            <label class="sw">
              <input type="checkbox" data-switch={d.key} checked />
              {d.label}
            </label>
          ))
        }
      </div>
      <p class="fine">{SWITCHES_SCOPE}</p>
      <!-- Draft words for Grant to rewrite. -->
      <p class="fine" id="inv-locked" data-locked hidden>{SWITCHES_LOCKED}</p>
    </section>
  </div>

  <!-- Told when the invoice is emailed, paid or started again. The notice itself is not the live
       region, so the same words are not read twice. -->
  <div class="visually-hidden" data-announce data-live aria-atomic="true"></div>
</div>

<style>
  /* Phone and tablet: one column, the copy above the screen. */
  .invoicing {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    padding-top: var(--space-2);
  }

  .copy h3 {
    margin-bottom: var(--space-2);
  }

  .copy p {
    margin: 0;
    max-width: 40rem;
    color: var(--muted);
  }

  /* 1100 px and wider there is room for the copy on the left, as in the Quoting tab. */
  @media (min-width: 1100px) {
    .invoicing {
      grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
      gap: var(--space-6);
      align-items: start;
    }
  }

  /* The invoice and its payments in one column, the switches card below them, or beside them from
     900 px. */
  .screen {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
    min-width: 0;
  }

  @media (min-width: 900px) {
    .screen {
      grid-template-columns: minmax(0, 1fr) minmax(0, 15rem);
    }
  }

  .main {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }

  .card {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-4);
    background: var(--white);
    border: 1px solid var(--frame);
    border-radius: 12px;
    overflow-wrap: break-word;
  }

  .card[hidden],
  .flash[hidden],
  .btn[hidden],
  .pay[hidden],
  [data-details][hidden],
  .part[hidden],
  [data-locked][hidden] {
    display: none;
  }

  .card h4 {
    margin: 0;
    font-family: var(--font-text);
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: normal;
  }

  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .head > div {
    min-width: 0;
  }

  .fine {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--muted);
  }

  /* The app's badges: a soft fill and border, with the status colour as text. */
  .badge {
    flex: none;
    padding: 1px 8px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .badge.draft {
    border-color: var(--status-neutral-border);
    background: var(--status-neutral-soft);
    color: var(--status-neutral);
  }

  .badge.sent {
    border-color: var(--status-active-border);
    background: var(--status-active-soft);
    color: var(--status-active);
  }

  .badge.paid {
    border-color: var(--status-success-border);
    background: var(--status-success-soft);
    color: var(--status-success);
  }

  .flash {
    margin: 0;
    padding: 8px 10px;
    border: 1px solid var(--status-success-border);
    border-radius: 8px;
    background: var(--status-success-soft);
    color: var(--status-success);
    font-size: 0.875rem;
  }

  /* The lines: the name and its details on the left, the line's total on the right. */
  .lines {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    font-variant-numeric: tabular-nums;
  }

  .lines li {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 9px 0;
    border-bottom: 1px solid var(--frame);
  }

  .lines li:first-child {
    border-top: 1px solid var(--frame);
  }

  .what {
    min-width: 0;
  }

  .name {
    display: block;
  }

  .det {
    display: block;
    font-size: 0.82rem;
    color: var(--muted);
  }

  /* A dot goes before every shown part that has a shown part ahead of it, so a part that comes back
     comes back in its place with its dot. A comma is the spoken text, so the parts do not run on. */
  .part:not([hidden]) ~ .part:not([hidden])::before {
    content: ' · ';
    content: ' · ' / ', ';
    white-space: pre;
  }

  .lines strong {
    flex: none;
    font-weight: 500;
  }

  .total {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: var(--space-4);
    font-variant-numeric: tabular-nums;
  }

  .total span {
    font-weight: 500;
  }

  .total strong {
    font: 500 1.35rem/1 var(--font-text);
  }

  .terms {
    display: grid;
    gap: var(--space-1);
  }

  /* The app's Dates list: the label muted, the value plain. */
  .dates {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-1) var(--space-4);
    margin: 0;
    font-size: 0.9rem;
  }

  .dates dt {
    color: var(--muted);
  }

  .dates dd {
    margin: 0;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .secondary {
    border: 1px solid var(--frame);
    background: var(--white);
    color: var(--deep-water);
  }

  .secondary:hover {
    background: var(--glass);
  }

  /* The payment form, drawn on the invoice as the app draws it. */
  .pay {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--frame);
    border-radius: 8px;
  }

  fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    padding: 0;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .how {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  .how label {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: var(--tap);
    padding: 0 12px;
    border: 1px solid var(--frame);
    border-radius: 8px;
    font-size: 0.95rem;
    cursor: pointer;
  }

  .how label:hover {
    background: var(--glass);
  }

  .how label:has(:checked) {
    border-color: var(--harbour);
  }

  .how input {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--harbour);
  }

  .amount {
    display: grid;
    gap: 4px;
    font-size: 0.9rem;
    font-weight: 500;
  }

  /* Read-only, because partial payments are a non-goal: the figure is fixed, so it is drawn flat. */
  .amount input {
    box-sizing: border-box;
    width: 100%;
    min-height: var(--tap);
    padding: 0 12px;
    border: 1px dashed var(--frame);
    border-radius: 8px;
    background: var(--glass);
    color: var(--muted);
    font: 400 1rem var(--font-text);
    font-variant-numeric: tabular-nums;
    cursor: default;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin: 0;
    font-size: 0.9rem;
  }

  .figure {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  /* The switches: checkboxes with a 44 px target. Fixed (and dimmed) once the invoice is sent. */
  .sw {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--tap);
    font-weight: 500;
    cursor: pointer;
  }

  .sw input {
    flex: none;
    width: 20px;
    height: 20px;
    margin: 0;
    accent-color: var(--harbour);
  }

  .sw:has(:disabled) {
    color: var(--muted);
    cursor: default;
  }
</style>
