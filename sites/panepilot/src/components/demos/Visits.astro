---
// The Visits demo (KAN-942): copy above or beside a copy of the app's job card. The visitor starts
// the clock, takes a break, ticks the checklist, finishes and completes the job. Written in the
// starting state for visitors without JavaScript: Scheduled, Not started, Start and a disabled
// Complete job, 0 of 3 done. visits.ts takes it from there.
import { CHECKLIST, NOT_STARTED, PAY_RULE, badgeFor, checklistCount } from '../../scripts/visits';

const start = badgeFor('notStarted');
---

<div class="visits">
  <div class="copy">
    <h3>Do the visit from your phone</h3>
    <p>
      The address, the access and parking notes and the hazards are on the job card. Start your time when
      you arrive, tick the checklist as you go, and complete the job. Its draft invoice is raised for you.
    </p>
    <p class="fine">The clock here runs a minute every half second, so you can watch the rounding.</p>
  </div>

  <div class="jobcard">
    <div class="head">
      <h4>Example Bakery</h4>
      <span class={`badge ${start.kind}`} data-badge>{start.label}</span>
    </div>

    <p class="flash" data-flash hidden></p>

    <div class="where">
      <span>1 Example St, Clare, SA, 5453</span>
      <span class="navigate">Navigate</span>
    </div>

    <p class="when">
      <b>Today</b> · 9:30 am – 10:45 am · 1 h 15 min
      <span>You and Sam Sample</span>
    </p>

    <section class="card notes" aria-labelledby="visits-notes-heading">
      <h5 id="visits-notes-heading">Access &amp; instructions</h5>
      <div class="hazard">
        <b>Hazards</b>
        <span>Dog in the yard. Ladder needed for the top windows.</span>
      </div>
      <p><span class="label">Access</span>Back gate is open before 10 am.</p>
      <p><span class="label">Parking</span>Park in the loading zone.</p>
    </section>

    <section class="card time" aria-labelledby="visits-time-heading">
      <h5 id="visits-time-heading">Your time on site</h5>
      <p class="fine">{PAY_RULE}</p>
      <p class="payable" data-payable>{NOT_STARTED}</p>
      <p class="fine" data-since hidden></p>
      <div class="buttons">
        <button type="button" class="btn btn-primary" data-start>Start</button>
        <button type="button" class="btn secondary" data-break hidden>Break</button>
        <button type="button" class="btn btn-primary" data-finish hidden>Finish</button>
      </div>
    </section>

    <section class="card check" aria-labelledby="visits-check-heading">
      <div class="head">
        <h5 id="visits-check-heading">Checklist</h5>
        <span class="fine" data-count data-live>{checklistCount(0)}</span>
      </div>
      {
        CHECKLIST.map((item) => (
          <button type="button" class="tick" aria-pressed="false" data-tick>
            {item}
          </button>
        ))
      }
    </section>

    <div class="bar">
      <button type="button" class="btn btn-primary" data-complete disabled>Complete job</button>
      <button type="button" class="btn secondary" data-reset hidden>Start again</button>
    </div>

    <!-- Told only when the phase or the rounded payable figure changes. The payable line itself
         changes twice a second while the clock runs, so it is not the live region. -->
    <div class="visually-hidden" data-announce data-live aria-atomic="true"></div>
  </div>
</div>

<style>
  /* Phone and tablet: one column, the copy above the card. */
  .visits {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    padding-top: var(--space-2);
  }

  .copy h3 {
    margin-bottom: var(--space-2);
  }

  .copy p {
    margin: 0 0 var(--space-2);
    max-width: 40rem;
    color: var(--muted);
  }

  .copy p:last-child {
    margin-bottom: 0;
  }

  /* 1100 px and wider there is room for the copy on the left, as in the Quoting tab. */
  @media (min-width: 1100px) {
    .visits {
      grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
      gap: var(--space-6);
      align-items: start;
    }
  }

  /* The job card, as the app draws it on a phone: never wider than 380 px. */
  .jobcard {
    display: grid;
    gap: 12px;
    justify-self: start;
    width: 100%;
    max-width: 380px;
    min-width: 0;
    padding: 14px;
    background: var(--glass);
    border: 1px solid var(--frame);
    border-radius: 16px;
    overflow-wrap: break-word;
  }

  .jobcard h4,
  .jobcard h5 {
    margin: 0;
    font-family: var(--font-text);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: normal;
  }

  .jobcard h4 {
    font-size: 1.15rem;
  }

  .jobcard h5 {
    font-size: 1rem;
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .head h4,
  .head h5 {
    min-width: 0;
  }

  /* The app's badges: a soft fill and border, with the status colour as text. */
  .badge {
    flex: none;
    padding: 1px 8px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .badge.scheduled {
    border-color: var(--status-neutral-border);
    background: var(--status-neutral-soft);
    color: var(--status-neutral);
  }

  .badge.progress {
    border-color: var(--status-active-border);
    background: var(--status-active-soft);
    color: var(--status-active);
  }

  .badge.done {
    border-color: var(--status-success-border);
    background: var(--status-success-soft);
    color: var(--status-success);
  }

  .flash {
    margin: 0;
    padding: 8px 10px;
    border: 1px solid var(--status-success-border);
    border-radius: 8px;
    background: var(--status-success-soft);
    color: var(--status-success);
    font-size: 0.875rem;
  }

  .flash[hidden],
  .btn[hidden],
  [data-since][hidden] {
    display: none;
  }

  /* "Navigate" is a label here, as the demo has nowhere to navigate to. */
  .where {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    font-size: 0.95rem;
  }

  .where > span:first-child {
    min-width: 0;
  }

  .navigate {
    flex: none;
    padding: 6px 10px;
    border: 1px solid var(--frame);
    border-radius: 8px;
    background: var(--white);
    color: var(--harbour-dark);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .when {
    margin: 0;
    font-size: 0.95rem;
  }

  .when span {
    display: block;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .card {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
    padding: var(--space-3);
    background: var(--white);
    border: 1px solid var(--frame);
    border-radius: 12px;
  }

  .notes p {
    display: grid;
    margin: 0;
    font-size: 0.9rem;
  }

  .label {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
  }

  /* The hazards are amber, the app's attention colours. */
  .hazard {
    display: grid;
    gap: 2px;
    padding: 8px 10px;
    border: 1px solid var(--status-attention-border);
    border-radius: 8px;
    background: var(--status-attention-soft);
    font-size: 0.9rem;
  }

  .hazard b {
    color: var(--status-attention);
    font-weight: 500;
  }

  .fine {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .payable {
    margin: 0;
    font: 500 1.25rem/1.25 var(--font-text);
    font-variant-numeric: tabular-nums;
  }

  .buttons,
  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .buttons .btn,
  .bar .btn {
    flex: 1;
  }

  .secondary {
    border: 1px solid var(--frame);
    background: var(--white);
    color: var(--deep-water);
  }

  .secondary:hover {
    background: var(--glass);
  }

  .btn:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .btn-primary:disabled:hover {
    background: var(--harbour);
  }

  /* The checklist: each item a toggle that turns green when ticked. */
  .tick {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--tap);
    padding: 0 12px;
    border: 1px solid var(--frame);
    border-radius: 8px;
    background: var(--white);
    color: var(--deep-water);
    font: 400 0.95rem var(--font-text);
    text-align: left;
    cursor: pointer;
  }

  .tick::before {
    content: '';
    flex: none;
    width: 18px;
    height: 18px;
    border: 1.5px solid var(--muted);
    border-radius: 4px;
  }

  .tick[aria-pressed='true'] {
    border-color: var(--status-success-border);
    background: var(--status-success-soft);
    color: var(--status-success);
  }

  .tick[aria-pressed='true']::before {
    display: grid;
    place-items: center;
    border-color: var(--status-success);
    content: '✓';
    content: '✓' / '';
    font-size: 0.75rem;
    line-height: 1;
  }

  /* Once the job is completed the ticks are fixed. */
  .tick:disabled {
    cursor: default;
  }

  .tick:disabled:not([aria-pressed='true']) {
    opacity: 0.6;
  }
</style>
