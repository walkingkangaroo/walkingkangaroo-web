---
import { Picture } from 'astro:assets';
import calendarWide from '../assets/screenshots/calendar-wide.png';
import quoteWide from '../assets/screenshots/quote-wide.png';
import invoicePaidWide from '../assets/screenshots/invoice-paid-wide.png';
import { site } from '../data/site';
import { offer } from '../data/offer';
import BrowserFrame from './BrowserFrame.astro';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container">
    <div class="hero__copy">
      <h1 id="hero-heading">Quoting, scheduling and invoicing for window cleaners.</h1>
      <p class="hero__line">
        Count the panes once. PanePilot books the round, runs the visit on your phone, invoices it and
        works out your workers' pay.
      </p>
      <div class="hero__cta">
        <a class="btn btn-primary" href={site.trialUrl}>Start your free trial</a>
        <small>{offer.trialLine}</small>
      </div>
    </div>

    <div class="hero__screens">
      <BrowserFrame class="hero__main" address="app.panepilot.au/calendar">
        {/* 3360 x 2100 source. The frame is about 743 px wide on a wide screen and the full width
             of the page at 760 px and narrower. */}
        <Picture
          src={calendarWide}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[640, 960, 1280, 1520]}
          sizes="(max-width: 760px) 100vw, (max-width: 1272px) 66vw, 760px"
          alt="PanePilot's week calendar on a wide screen, with the menu on the left and the Shops run shown as one block on Thursday"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </BrowserFrame>

      {/* Both sources are 3360 x 2100. Each small frame is a third of the grid: about 30 vw from 761 px,
           and a fixed 371 px once the page stops growing at 1200 px (sizes keeps the calendar's 1272 px
           step, which only over-states it a little). At 760 px and narrower it is half the row, about
           45 vw (sizes says 46). They sit below the fold on a phone, so they load lazily. */}
      <BrowserFrame address="app.panepilot.au/quotes">
        <Picture
          src={quoteWide}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[480, 720, 960, 1120]}
          sizes="(max-width: 760px) 46vw, (max-width: 1272px) 31vw, 372px"
          alt="PanePilot's quote QTE-0057 for Placeholder Co on a wide screen: marked Sent, with buttons to email again, mark accepted or declined, and a table of 18 standard panes and 6 large panes totalling $225.00"
          loading="lazy"
          decoding="async"
        />
      </BrowserFrame>
      <BrowserFrame address="app.panepilot.au/invoices">
        <Picture
          src={invoicePaidWide}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[480, 720, 960, 1120]}
          sizes="(max-width: 760px) 46vw, (max-width: 1272px) 31vw, 372px"
          alt="PanePilot's invoice INV-1042 for Example Bakery on a wide screen: marked Paid, with the $225.00 bank transfer recorded under Payments and $0.00 still owed"
          loading="lazy"
          decoding="async"
        />
      </BrowserFrame>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-5);
    padding-bottom: var(--space-7);
  }

  .hero__copy {
    max-width: 46rem;
  }

  .hero h1 {
    margin-bottom: var(--space-4);
  }

  .hero__line {
    max-width: 40rem;
    margin: 0 0 var(--space-4);
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }

  .hero__cta small {
    color: var(--muted);
    font-size: 0.95rem;
  }

  /* Desktop: the calendar spans two rows on the left, the two small frames stack on the right. */
  .hero__screens {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: auto auto;
    gap: 14px;
    margin-top: var(--space-6);
  }

  .hero__screens :global(.hero__main) {
    grid-row: span 2;
  }

  .hero__screens :global(.browser img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 761px) {
    .hero {
      padding-top: var(--space-7);
      padding-bottom: var(--space-8);
    }

    .hero__line {
      font-size: 1.25rem;
    }
  }

  /* 760 px and narrower: the calendar full width, the two small frames in a row of two under it. */
  @media (max-width: 760px) {
    .hero__screens {
      grid-template-columns: 1fr 1fr;
    }

    .hero__screens :global(.hero__main) {
      grid-column: span 2;
      grid-row: auto;
    }
  }
</style>
