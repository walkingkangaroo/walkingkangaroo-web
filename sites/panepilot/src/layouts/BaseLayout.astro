---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import manrope800 from '@fontsource/manrope/files/manrope-latin-800-normal.woff2?url';
import calendarWide from '../assets/screenshots/calendar-wide.png';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  /** The page's whole title. */
  title: string;
  description: string;
  /**
   * Keep the page out of search results. Also leaves out the canonical link and the og/twitter
   * tags: the 404 page is served at every missing address, so a URL or share card would name
   * the wrong page.
   */
  noindex?: boolean;
}

const SITE_NAME = 'PanePilot';
const { title, description, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

// The link preview: the wide calendar screenshot (3360 x 2100) scaled to 1200 wide and cropped to
// 1200 x 630 from the top, so the app's header and the week's top rows stay in. Made at build time
// from the one source file, so a recaptured screenshot updates it.
const og = await getImage({
  src: calendarWide,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'top',
  format: 'png',
});
const imageUrl = new URL(og.src, Astro.site);
const imageAlt =
  "PanePilot's week calendar on a wide screen, with the menu on the left and the Shops run shown as one block";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}

    <link rel="preload" href={manrope800} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {
      !noindex && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={SITE_NAME} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:image" content={imageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={imageAlt} />
          <meta property="og:locale" content="en_AU" />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={imageUrl} />
          <meta name="twitter:image:alt" content={imageAlt} />
        </>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
