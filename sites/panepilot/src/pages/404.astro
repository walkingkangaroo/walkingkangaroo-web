---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="Page not found · PanePilot" description="There's nothing at this address." noindex>
  <div class="container page">
    <h1>Page not found</h1>
    <p>There's nothing at this address.</p>
    <p class="actions">
      <a class="home" href="/">Back to the home page</a>
      <a class="btn btn-primary" href={site.trialUrl}>Start your free trial</a>
    </p>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
  }

  .home {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 500;
  }
</style>
