---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HowSection from '../components/HowSection.astro';
import ProcessTabs from '../components/demos/ProcessTabs.astro';
import MadeFor from '../components/MadeFor.astro';
import Workers from '../components/Workers.astro';
import Story from '../components/Story.astro';
import Pricing from '../components/Pricing.astro';
import NotYet from '../components/NotYet.astro';
import Questions from '../components/Questions.astro';
import { site } from '../data/site';
import { offer } from '../data/offer';

const title = 'PanePilot: quoting, scheduling and invoicing for window cleaners';
const description =
  "Count the panes once. PanePilot books the round, runs each visit on your phone, invoices it and works out your workers' pay. Made for Australian window cleaners.";

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  url: site.url,
  description,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any device with a web browser',
  inLanguage: 'en-AU',
  offers: {
    '@type': 'Offer',
    price: String(offer.price),
    priceCurrency: offer.currency,
    description: offer.schemaDescription,
    url: site.trialUrl,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: String(offer.price),
      priceCurrency: offer.currency,
      unitText: 'MONTH',
    },
  },
};
---

<BaseLayout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Hero />
  <HowSection><ProcessTabs /></HowSection>
  <MadeFor />
  <Workers />
  <Story />
  <Pricing />
  <NotYet />
  <Questions />
</BaseLayout>
